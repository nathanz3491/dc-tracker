# Copy to .env in this same directory (it is gitignored) and fill in.
#
#   cp .env.example .env
#
# This file's location matters: the project's .env is read by absolute path, so it
# applies no matter which directory you run `tracker` from. A .env in the current
# directory is also read and takes precedence, if you want a per-directory
# override.
#
# Every variable carries the TRACKER_ prefix. All are optional except the API key,
# and only `ingest crawl` needs that.

# --- DeepSeek --------------------------------------------------------------
# One platform, one host, OpenAI-compatible. Keys from platform.deepseek.com.
#
# This replaced MiniMax. TRACKER_MINIMAX_* variables are no longer read by
# anything; a MiniMax key pasted below returns HTTP 401.
#
# Verify the key before spending a run's worth of fetches:
#   tracker ingest crawl --check
TRACKER_DEEPSEEK_API_KEY=
TRACKER_DEEPSEEK_BASE_URL=https://api.deepseek.com
TRACKER_DEEPSEEK_MODEL=deepseek-v4-flash

# Model for `tracker infer` -- judgement rather than transcription, one call per
# project, and the only caller that turns reasoning on. deepseek-v4-pro is the
# heavier option if the readings are not good enough.
# TRACKER_DEEPSEEK_REASONING_MODEL=deepseek-v4-flash
# TRACKER_DEEPSEEK_REASONING_EFFORT=high

# Ask the provider to enforce JSON rather than relying on this tool's own
# parse -> repair -> validate -> retry. Off on purpose: DeepSeek's JSON mode
# requires the word `json` in the prompt and "has a probability of returning
# empty content", and an empty reply is the one failure the tolerant reader in
# tracker/llm.py cannot recover from.
# TRACKER_DEEPSEEK_JSON_MODE=false

# --- Web search (for `tracker search` and `tracker enrich`) ----------------
# Optional: feeds and sitemap archives work without any of these. Add ONE key and
# it is picked up automatically.
#
# There is deliberately no Bing option. Microsoft retired the standalone Bing
# Search APIs on 2025-08-11 (their docs page carries `is_retired: true`), so no
# new key can be created. Its successor, Grounding with Bing Search in Azure AI
# Foundry, is licensed for grounding a model's reply rather than for building a
# stored database of facts and citations — which is what this tool does.

# Serper — START HERE. Google's index over one simple API. Its signup states
# "2,500 free queries, no credit card required", and it needs one variable.
#   https://serper.dev
TRACKER_SERPER_API_KEY=

# Google Programmable Search — the same index direct, 100 queries/day free and no
# card, but two setup steps instead of one.
#   key: https://developers.google.com/custom-search/v1/introduction
#   cx:  https://programmablesearchengine.google.com  (set it to search the
#        entire web, not a fixed list of sites)
TRACKER_GOOGLE_API_KEY=
TRACKER_GOOGLE_CSE_ID=

# Brave — an independent index, so it finds what Google does not. 2000
# queries/month free, but the signup asks for a card. Reach for it second.
#   https://api-dashboard.search.brave.com
TRACKER_BRAVE_API_KEY=

# Which backend to use. "auto" (the default) takes the first one holding a key,
# in the order google, brave, serper. Name one to pin it.
# TRACKER_SEARCH_PROVIDER=serper
# TRACKER_SEARCH_RESULTS_PER_QUERY=10   # Google caps a single call at 10
# TRACKER_SEARCH_MAX_QUERIES=10         # per run, so a bad set cannot burn the quota

# --- Database --------------------------------------------------------------
# Defaults to <project root>/data/tracker.db. Overridable per-command with --db.
# TRACKER_DB=data/tracker.db

# --- Fetching --------------------------------------------------------------
# TRACKER_FETCH_CONCURRENCY=4
# TRACKER_POLITENESS_DELAY_S=1.0
# TRACKER_FETCH_TIMEOUT_S=30.0
# TRACKER_USER_AGENT=dc-tracker/0.1 (+contact: set-me@example.com)

# --- LLM cost bounds -------------------------------------------------------
# TRACKER_MAX_INPUT_CHARS=24000
# TRACKER_MAX_COMPLETION_TOKENS=4096
# TRACKER_LLM_MAX_ATTEMPTS=2

# --- Console ---------------------------------------------------------------
# Password for `tracker serve`. Optional on loopback -- reaching 127.0.0.1
# already means having the machine. REQUIRED by `tracker serve --tunnel`, which
# publishes a public URL in front of a process that runs commands and can spend
# LLM tokens; the command refuses to start without it.
#
# Read from the environment rather than taken as a --password flag on purpose: a
# flag lands in shell history and in `ps` output for every user on the box.
TRACKER_CONSOLE_PASSWORD=

# --- Publishing ----------------------------------------------------------
# A named cloudflared tunnel and the hostname routed to it. Set both or neither.
# With them set, `tracker cloudflare` takes no arguments and the URL is stable
# across restarts; without them it falls back to an anonymous quick tunnel with
# a new *.trycloudflare.com address every session.
#
# Create the pair once, outside this tool -- it writes credentials into your home
# directory and a DNS record into your zone, both of which outlive the process:
#   cloudflared tunnel login
#   cloudflared tunnel create dc-console
#   cloudflared tunnel route dns dc-console console.example.com
#
# Neither value is a secret; they are here because they are per-machine.
TRACKER_TUNNEL_NAME=
TRACKER_TUNNEL_HOSTNAME=

# Model for the drawer's written briefing -- the one call a person sits and waits
# for, since the panel generates when a project row is opened.
#
# Latency here is a THINKING question, not a model question. On MiniMax this had
# to be a different and less accurate model (M2-her, the only one that did not
# deliberate: 2.7s to the first visible word against 12-47s for the rest), and it
# sometimes read the data wrong -- on a row whose construction track said
# `nothing reached` it wrote "All tracks complete". DeepSeek honours
# `thinking: disabled`, so the fast path is now the same model with reasoning off
# and that trade is gone.
# TRACKER_DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# --- Compute ---------------------------------------------------------------
# Facility power per H200-equivalent accelerator, in kilowatts, used to restate a
# site's megawatts as compute (the `h200_equivalent` column).
#
# 1.3 is built from published figures, not picked: the H200 SXM board is 700 W; a
# DGX H200 draws 8.5 kW for eight of them, so 1.06 kW per GPU of node-level IT
# load, which is what a data center actually powers; and a liquid-cooled AI hall
# is underwritten at PUE 1.15-1.25 for 2026. 1.06 x 1.2 = ~1.3, or ~770 per MW.
#
# Every input to that ages. Change this and run `tracker init` to re-base the
# whole table -- the column is recomputed, never migrated.
TRACKER_KW_PER_H200=1.3
